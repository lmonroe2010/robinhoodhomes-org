---
// Robin Hood Homes — base HTML shell.
// Single-page marketing site for the SB 1079 housing program. This layout is
// shared by index.astro and thank-you.astro so head/meta stay consistent.
export interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of the current page, used for canonical + og:url. */
  url?: string;
}

const {
  title = 'Robin Hood Homes — Taking back homes for people, not corporations.',
  description = "Robin Hood Homes uses California's SB 1079 to buy foreclosed homes before corporate investors can — and deed-restricts them as affordable housing for 30 years. A subsidiary of Strategic Solutions, Inc.",
  url = 'https://robinhoodhomes.org/',
} = Astro.props;

import '../styles/tokens.css';
import '../styles/styles.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1F3D2C" />
  <link rel="canonical" href={url} />

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Robin Hood Homes" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content="https://robinhoodhomes.org/assets/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://robinhoodhomes.org/assets/og-image.png" />
</head>
<body>
  <slot />
</body>
</html>
