---
// Property pipeline — 16 SB 1079 acquisitions across California. Photos use
// a diagonal-stripe placeholder until real photography is added. The filter
// chips run client-side via a tiny inline script (no framework runtime).
type Status = 'active' | 'pending' | 'occupied' | 'construction' | 'dual' | 'rental' | 'suspense';

interface Property {
  id: number;
  addr: string;
  city: string;
  status: Status;
  redfin?: string;
  detail: string;
}

const PROPERTIES: Property[] = [
  { id: 1,  addr: '2586 Willow St',         city: 'Nicolaus',      status: 'active',       redfin: 'https://www.redfin.com/CA/Nicolaus/2586-Willow-St-95659/home/123435308', detail: 'A country gem.' },
  { id: 2,  addr: '1662 Glazier Dr',        city: 'Concord',       status: 'pending',      detail: 'Meticulous remodel and the pride of the neighborhood.' },
  { id: 3,  addr: '1511 Russell St',        city: 'Berkeley',      status: 'occupied',     detail: 'Occupied — waiting for access.' },
  { id: 4,  addr: '4620 Wendlis Rd',        city: 'Forest Ranch',  status: 'pending',      detail: 'Country home with solar, a pool, and unlimited potential.' },
  { id: 5,  addr: '648 Thornton Ave',       city: 'San Francisco', status: 'active',       redfin: 'https://www.redfin.com/CA/San-Francisco/648-Thornton-Ave-94124/home/994794', detail: 'Classically chic SF stunner with a separate studio unit.' },
  { id: 6,  addr: '1444 9th Ave',           city: 'Oakland',       status: 'occupied',     detail: 'Occupied — waiting for access.' },
  { id: 7,  addr: '375 Senter Rd',          city: 'San Jose',      status: 'construction', detail: 'Launching June 2026 — a full studs-out remodel.' },
  { id: 8,  addr: '80628 Camino San Lucas', city: 'Indio',         status: 'occupied',     detail: 'Occupied — waiting for access.' },
  { id: 9,  addr: '15315 Pearl Ct',         city: 'Pioneer',       status: 'construction', detail: 'In construction — launching late June 2026.' },
  { id: 10, addr: '1998 Calaveras Dr',      city: 'Bay Point',     status: 'occupied',     detail: 'Occupied — waiting for access.' },
  { id: 11, addr: '1222 D St',              city: 'Ramona',        status: 'occupied',     detail: 'Occupied — waiting for access.' },
  { id: 12, addr: '1210 W Milling St',      city: 'Lancaster',     status: 'occupied',     detail: 'Occupied — waiting for access.' },
  { id: 13, addr: '7927 MacArthur Blvd',    city: 'Oakland',       status: 'pending',      detail: 'Selling to prior long-term tenants.' },
  { id: 14, addr: '1041 Lettia Rd',         city: 'San Pablo',     status: 'rental',       detail: 'Portfolio property — long-term rental with tenants in place.' },
  { id: 15, addr: '85 La Encinal',          city: 'Orinda',        status: 'active',       redfin: 'https://www.redfin.com/CA/Orinda/85-La-Encinal-94563/home/1970758', detail: 'Top-of-the-world views and top-rated schools.' },
  { id: 16, addr: '4609 Ranch Pl',          city: 'Antioch',       status: 'pending',      detail: 'Barely-lived-in new construction with a huge yard.' },
  { id: 17, addr: '510 Emily Rose Cir',     city: 'Windsor',       status: 'active',       detail: 'Available now — inquire for details.' },
  { id: 18, addr: '2288 Marconi Ave',       city: 'Sacramento',    status: 'construction', detail: 'Work in progress — remodel underway.' },
  { id: 19, addr: '265 S Barrington Ave #E7', city: 'Los Angeles', status: 'occupied',     detail: 'Occupied — waiting for access.' },
  { id: 20, addr: '2346 W College Ave',     city: 'Santa Rosa',    status: 'construction', detail: 'Work in progress — remodel underway.' },
];

const STATUS_LABEL: Record<Status, string> = {
  active:       'Active',
  pending:      'Pending',
  construction: 'In Construction',
  occupied:     'Occupied',
  dual:         'Occupied · Dual Track',
  rental:       'Rental',
  suspense:     'Suspense',
};

const FILTERS: { key: 'all' | Status; label: string }[] = [
  { key: 'all',          label: 'All' },
  { key: 'active',       label: 'Active' },
  { key: 'pending',      label: 'Pending' },
  { key: 'construction', label: 'In construction' },
  { key: 'occupied',     label: 'Occupied' },
  { key: 'rental',       label: 'Rental' },
  { key: 'suspense',     label: 'Suspense' },
];

const counts: Record<string, number> = PROPERTIES.reduce(
  (m, p) => ({ ...m, [p.status]: (m[p.status] || 0) + 1 }),
  {} as Record<string, number>,
);
const uniqCities = new Set(PROPERTIES.map((p) => p.city)).size;
const activePipelineCount = (counts.construction || 0) + (counts.pending || 0) + (counts.active || 0);

const redfinUrl = (p: Property): string =>
  p.redfin ||
  'https://www.redfin.com/?searchQueryText=' + encodeURIComponent(p.addr + ', ' + p.city + ', CA');
---
<section class="section" id="pipeline">
  <div class="container">
    <div class="pipeline__head">
      <div>
        <div class="eyebrow">03 · Our portfolio</div>
        <h2>Properties &amp; <span class="accent">pipeline.</span></h2>
      </div>
      <p class="lead">
        Every property below has been acquired through California's SB 1079
        post-foreclosure program. All purchases carry 30-year affordable housing
        deed restrictions.
      </p>
    </div>

    <div class="portfolio-stats">
      <div class="portfolio-stat">
        <div class="portfolio-stat__num tabular">{PROPERTIES.length}</div>
        <div class="portfolio-stat__lbl">Active properties</div>
      </div>
      <div class="portfolio-stat">
        <div class="portfolio-stat__num tabular">{uniqCities}</div>
        <div class="portfolio-stat__lbl">California cities</div>
      </div>
      <div class="portfolio-stat">
        <div class="portfolio-stat__num tabular">{activePipelineCount}</div>
        <div class="portfolio-stat__lbl">Active, pending, or in construction</div>
      </div>
      <div class="portfolio-stat">
        <div class="portfolio-stat__num tabular">30<span style="font-size:24px; margin-left:4px; color:var(--rhh-gold)">yr</span></div>
        <div class="portfolio-stat__lbl">Deed restriction on every property</div>
      </div>
    </div>

    <div class="filter-row" data-filter-row>
      {FILTERS.map((f) => {
        const n = f.key === 'all' ? PROPERTIES.length : (counts[f.key] || 0);
        return (
          <button
            type="button"
            class={'filter-chip' + (f.key === 'all' ? ' is-active' : '')}
            data-filter={f.key}
          >
            {f.label}
            <span class="filter-chip__n tabular">{n}</span>
          </button>
        );
      })}
    </div>

    <div class="pcards" data-pcards>
      {PROPERTIES.map((p) => {
        const isActive = p.status === 'active';
        const href = redfinUrl(p);
        return (
          <article class="pcard" data-status={p.status}>
            <div class="pcard__photo">
              <div class={'pcard__status pcard__status--' + p.status}>
                <span class="pdot" aria-hidden="true"></span>
                <span>{STATUS_LABEL[p.status]}</span>
              </div>
              <div class="pcard__photo-placeholder">Coming Soon</div>
              {isActive && (
                <a
                  class="pcard__redfin"
                  href={href}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={'View ' + p.addr + ' on Redfin'}
                >
                  View on Redfin <span class="arrow">↗</span>
                </a>
              )}
            </div>
            <div class="pcard__body">
              <div class="pcard__id tabular">{String(p.id).padStart(2, '0')} / {String(PROPERTIES.length).padStart(2, '0')}</div>
              <h3 class="pcard__addr">{p.addr}</h3>
              <div class="pcard__city">{p.city}, CA</div>
              <div class="pcard__detail">{p.detail}</div>
              {isActive ? (
                <a class="pcard__cta" href={href} target="_blank" rel="noreferrer">
                  View listing on Redfin <span class="arrow">↗</span>
                </a>
              ) : (
                <a class="pcard__cta" href="#contact">
                  Inquire <span class="arrow">→</span>
                </a>
              )}
            </div>
          </article>
        );
      })}
      <div class="ptable__empty" data-empty hidden style="grid-column: 1 / -1">No properties match this filter right now.</div>
    </div>

    <div class="pipeline__cta">
      <p>Have a property lead, or want to inquire about one of ours?</p>
      <a href="#contact" class="btn btn--primary">
        Inquire about a property <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  const row = document.querySelector<HTMLElement>('[data-filter-row]');
  const grid = document.querySelector<HTMLElement>('[data-pcards]');
  const empty = grid?.querySelector<HTMLElement>('[data-empty]');
  if (row && grid && empty) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.pcard'));
    row.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target.closest('button[data-filter]') : null;
      if (!(target instanceof HTMLButtonElement)) return;
      const filter = target.dataset.filter;
      row.querySelectorAll('.filter-chip').forEach((b) => b.classList.toggle('is-active', b === target));
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === 'all' || card.dataset.status === filter;
        card.hidden = !match;
        if (match) shown += 1;
      });
      empty.hidden = shown !== 0;
    });
  }
</script>
