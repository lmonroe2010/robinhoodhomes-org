---
// Sticky site header. Logo locked to "bullseye-house" — concentric target
// rings with a tiny house silhouette in the middle (the Robin Hood mark).
---
<header class="nav">
  <div class="nav__inner">
    <a class="nav__brand" href="#top">
      <span class="nav__mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="butt" stroke-linejoin="miter">
          <circle cx="12" cy="12" r="10.5" />
          <circle cx="12" cy="12" r="7.5" />
          <circle cx="12" cy="12" r="4.5" />
          <path d="M9 13.5 L12 11 L15 13.5" />
          <path d="M9.8 13 V15.6 H14.2 V13" />
        </svg>
      </span>
      <span class="nav__brand-text">
        <span class="nav__brand-name">Robin Hood Homes</span>
        <span class="nav__brand-sub">A subsidiary of Strategic Solutions, Inc.</span>
      </span>
    </a>
    <nav>
      <ul class="nav__links">
        <li><a href="#why">Why We Do It</a></li>
        <li><a href="#how">How It Works</a></li>
        <li><a href="#pipeline">Properties</a></li>
        <li><a href="#money">Follow the Money</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
    <div class="nav__cta">
      <a href="#contact" class="btn btn--primary">
        Get In Touch <span class="arrow">→</span>
      </a>
    </div>
  </div>
</header>
