---
// Follow the Money — the 50/25/25 reinvestment story.
const ALLOCATION = [
  { pct: 50, label: 'Community Grants',   sub: 'to local Sonoma County nonprofits' },
  { pct: 25, label: 'Housing Investment', sub: '↳ this work' },
  { pct: 25, label: 'Grant Writing',      sub: 'full-time staff position' },
];
---
<section class="section section--soft" id="money">
  <div class="container">
    <div class="money">
      <div class="money__copy">
        <div class="eyebrow">04 · Follow the money</div>
        <h2>Every dollar we earn<br />goes <span class="accent">back home.</span></h2>
        <p class="lead" style="margin-top: 24px;">
          Robin Hood Homes, LLC is a wholly-owned subsidiary of Strategic Solutions, Inc.,
          a California nonprofit based in Sebastopol. Every dollar of operating surplus
          flows back to Strategic Solutions and is redeployed into West Sonoma County
          through grants, housing investment, and a dedicated grant-writing position.
        </p>
        <div class="flow__cycle">
          The flip is the means. <strong>The mission is the destination.</strong>
        </div>
        <div style="margin-top: 24px;">
          <a href="https://castrategicsolutions.org" target="_blank" rel="noreferrer" class="btn btn--outline">
            Visit CaStrategicSolutions.org ↗
          </a>
        </div>
      </div>

      <div class="flow">
        {ALLOCATION.map((a) => (
          <div class="flow__row">
            <div class="flow__pct tabular">{a.pct}<span style="font-size:40px">%</span></div>
            <div class="flow__bar" style={`width: ${a.pct === 50 ? '100%' : '70%'}`}>
              {a.label}
              <span class="flow__sub">{a.sub}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
